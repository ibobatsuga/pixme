# ==========================================
# PICME ENVIRONMENT CONFIGURATION
# ==========================================

# 1. STORAGE DRIVER
# Options: "local" (default for offline dev) or "s3" (cloud object storage)
STORAGE_DRIVER=local

# 2. S3-COMPATIBLE OBJECT STORAGE (Biznet GIO NEO / Cloudflare R2 / Supabase)
# Saat siap publish di Biznet GIO NEO Object Storage:
# S3_ENDPOINT_URL=https://nos.jkt-1.neo.id
# S3_ACCESS_KEY=your_biznet_gio_access_key
# S3_SECRET_KEY=your_biznet_gio_secret_key
# S3_BUCKET_NAME=picme-media
# S3_PUBLIC_DOMAIN=https://picme-media.nos.jkt-1.neo.id

# Saat masa staging di Cloudflare R2 / Supabase Storage (Free Tier):
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your_r2_access_key
# S3_SECRET_KEY=your_r2_secret_key
# S3_BUCKET_NAME=picme-staging
# S3_PUBLIC_DOMAIN=https://pub-<hash>.r2.dev

# 3. DATABASE CONFIGURATION
# Staging: SQLite lokal (eventphoto.db) atau Supabase PostgreSQL
# Production Biznet GIO: PostgreSQL dengan ekstensi pgvector
DATABASE_URL=sqlite:///./backend/eventphoto.db

# 4. FACE AI ENGINE (InsightFace SOTA)
# Detector: SCRFD-34GF
# Recognizer: ArcFace Glint360k (IResNet-100)
FACE_DETECTOR_MODEL=models/scrfd_34g_shape.onnx
FACE_RECOGNIZER_MODEL=models/glint360k_r100.onnx
