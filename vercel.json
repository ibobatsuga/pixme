{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/deck",
      "dest": "/frontend/deck.html"
    },
    {
      "src": "/deck/(.*)",
      "dest": "/frontend/deck.html"
    },
    {
      "src": "/pitch",
      "dest": "/frontend/deck.html"
    },
    {
      "src": "/pitch/(.*)",
      "dest": "/frontend/deck.html"
    },
    {
      "src": "/photographer",
      "dest": "/frontend/photographer.html"
    },
    {
      "src": "/photographer/(.*)",
      "dest": "/frontend/photographer.html"
    },
    {
      "src": "/admin",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/login.html",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/index.html",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/frontend/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
